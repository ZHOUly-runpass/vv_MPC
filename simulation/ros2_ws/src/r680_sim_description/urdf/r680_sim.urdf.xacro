<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="r680_sim">
  <xacro:arg name="use_ros2_control" default="false"/>
  <!-- Simulation assumptions only. Replace after physical R680 measurement. -->
  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width" value="0.05"/>
  <xacro:property name="wheel_separation" value="0.48"/>

  <material name="chassis_blue"><color rgba="0.08 0.22 0.55 1"/></material>
  <material name="wheel_black"><color rgba="0.03 0.03 0.03 1"/></material>
  <material name="sensor_gray"><color rgba="0.25 0.25 0.25 1"/></material>

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 0.18" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial><origin xyz="0 0 0"/><mass value="35.0"/><inertia ixx="0.70" ixy="0" ixz="0" iyy="1.20" iyz="0" izz="1.55"/></inertial>
    <visual><geometry><box size="0.60 0.44 0.24"/></geometry><material name="chassis_blue"/></visual>
    <collision><geometry><box size="0.60 0.44 0.24"/></geometry></collision>
  </link>

  <xacro:macro name="drive_wheel" params="side sign">
    <link name="${side}_wheel_link">
      <inertial><mass value="1.2"/><inertia ixx="0.006" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.011"/></inertial>
      <visual><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry><material name="wheel_black"/></visual>
      <collision><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry></collision>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${side}_wheel_link"/>
      <origin xyz="0 ${sign * wheel_separation/2} -0.08"/><axis xyz="0 1 0"/>
      <dynamics damping="0.1" friction="0.05"/>
    </joint>
  </xacro:macro>
  <xacro:drive_wheel side="left" sign="1"/>
  <xacro:drive_wheel side="right" sign="-1"/>

  <xacro:macro name="caster" params="name x">
    <link name="${name}_caster_link">
      <inertial><mass value="0.3"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
      <visual><geometry><sphere radius="0.045"/></geometry><material name="wheel_black"/></visual>
      <collision><geometry><sphere radius="0.045"/></geometry></collision>
    </link>
    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/><child link="${name}_caster_link"/><origin xyz="${x} 0 -0.135"/>
    </joint>
  </xacro:macro>
  <xacro:caster name="front" x="0.25"/>
  <xacro:caster name="rear" x="-0.25"/>

  <link name="laser_2d_link">
    <visual><geometry><cylinder radius="0.045" length="0.04"/></geometry><material name="sensor_gray"/></visual>
  </link>
  <joint name="laser_2d_joint" type="fixed"><parent link="base_link"/><child link="laser_2d_link"/><origin xyz="0.18 0 0.15"/></joint>

  <link name="c16_link">
    <visual><geometry><cylinder radius="0.055" length="0.08"/></geometry><material name="sensor_gray"/></visual>
  </link>
  <joint name="c16_joint" type="fixed"><parent link="base_link"/><child link="c16_link"/><origin xyz="0.08 0 0.25"/></joint>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed"><parent link="base_link"/><child link="imu_link"/><origin xyz="0 0 0.05"/></joint>

  <gazebo reference="base_link"><material>Gazebo/Blue</material></gazebo>
  <gazebo reference="left_wheel_link"><mu1>1.2</mu1><mu2>1.2</mu2><material>Gazebo/Black</material></gazebo>
  <gazebo reference="right_wheel_link"><mu1>1.2</mu1><mu2>1.2</mu2><material>Gazebo/Black</material></gazebo>
  <gazebo reference="front_caster_link"><mu1>0.05</mu1><mu2>0.05</mu2></gazebo>
  <gazebo reference="rear_caster_link"><mu1>0.05</mu1><mu2>0.05</mu2></gazebo>

  <gazebo if="$(eval arg('use_ros2_control') == 'false')">
    <plugin name="r680_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros><namespace>/</namespace><remapping>cmd_vel:=cmd_vel</remapping><remapping>odom:=odom</remapping></ros>
      <update_rate>50</update_rate><left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation><wheel_diameter>${2 * wheel_radius}</wheel_diameter>
      <max_wheel_torque>45</max_wheel_torque><max_wheel_acceleration>1.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom><publish_odom_tf>true</publish_odom_tf><publish_wheel_tf>true</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame><robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <ros2_control name="GazeboSystem" type="system" if="$(eval arg('use_ros2_control') == 'true')">
    <hardware><plugin>gazebo_ros2_control/GazeboSystem</plugin></hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity"><param name="min">-12.0</param><param name="max">12.0</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity"><param name="min">-12.0</param><param name="max">12.0</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
  </ros2_control>
  <gazebo if="$(eval arg('use_ros2_control') == 'true')">
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <robot_param>robot_description</robot_param><robot_param_node>robot_state_publisher</robot_param_node>
      <parameters>$(find r680_sim_description)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <gazebo reference="laser_2d_link">
    <sensor name="safety_scan" type="ray"><always_on>true</always_on><update_rate>15</update_rate><visualize>false</visualize>
      <ray><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-${pi}</min_angle><max_angle>${pi}</max_angle></horizontal></scan>
        <range><min>0.12</min><max>30.0</max><resolution>0.01</resolution></range><noise><type>gaussian</type><mean>0</mean><stddev>0.005</stddev></noise></ray>
      <plugin name="scan_ros" filename="libgazebo_ros_ray_sensor.so"><ros><remapping>~/out:=scan</remapping></ros><output_type>sensor_msgs/LaserScan</output_type><frame_name>laser_2d_link</frame_name></plugin>
    </sensor>
  </gazebo>

  <gazebo reference="c16_link">
    <sensor name="c16_sim" type="ray"><always_on>true</always_on><update_rate>10</update_rate><visualize>false</visualize>
      <ray><scan>
        <horizontal><samples>900</samples><resolution>1</resolution><min_angle>-${pi}</min_angle><max_angle>${pi}</max_angle></horizontal>
        <vertical><samples>16</samples><resolution>1</resolution><min_angle>-${15*pi/180}</min_angle><max_angle>${15*pi/180}</max_angle></vertical>
      </scan><range><min>0.30</min><max>50.0</max><resolution>0.02</resolution></range><noise><type>gaussian</type><mean>0</mean><stddev>0.01</stddev></noise></ray>
      <plugin name="c16_ros" filename="libgazebo_ros_ray_sensor.so"><ros><remapping>~/out:=points_raw</remapping></ros><output_type>sensor_msgs/PointCloud2</output_type><frame_name>c16_link</frame_name></plugin>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu"><always_on>true</always_on><update_rate>100</update_rate>
      <plugin name="imu_ros" filename="libgazebo_ros_imu_sensor.so"><ros><remapping>~/out:=imu/data_raw</remapping></ros><initial_orientation_as_reference>false</initial_orientation_as_reference><frame_name>imu_link</frame_name></plugin>
    </sensor>
  </gazebo>
</robot>
